# Copier ce fichier en `.env` (à la racine de /server) et compléter les valeurs.
# `.env` ne doit JAMAIS être commité (voir .gitignore).

# --- Serveur ---
PORT=3000

# --- Base de données (SQLite, module natif node:sqlite — aucune dépendance) ---
# Chemin du fichier de base. Par défaut : server/data/quiz.db (dossier ignoré
# par git). Mettre ":memory:" pour une base éphémère (tests). Le schéma est
# appliqué au démarrage (server/db/schema.sql).
DB_PATH=

# --- Sécurité : code d'accès ---
# Vérifié par middlewares/accessCode.js via l'en-tête X-Access-Code.
# Si laissé VIDE : le contrôle est désactivé (mode développement) et un
# avertissement est affiché au démarrage.
ACCESS_CODE=

# --- Fournisseur LLM : Google Gemini (API REST, fetch natif, sans SDK) ---
# Le provider est isolé dans services/llm.service.js (fonction callLLM).
# Si le modèle indiqué est retiré (404) ou saturé (503), le service bascule
# automatiquement sur un modèle Flash de repli et l'indique dans les logs.
LLM_PROVIDER=gemini
LLM_API_KEY=your-google-generative-language-api-key
LLM_MODEL=gemini-3.5-flash

# --- Quotas par IP (quota.service.js) ---
# 5 requêtes par heure et 20 par jour, par adresse IP (fenêtres glissantes).
RATE_LIMIT_PER_IP=5
RATE_LIMIT_PER_IP_DAY=20
# Fenêtre horaire indicative (les fenêtres réelles 1 h / 24 h sont fixes).
RATE_LIMIT_WINDOW_MS=3600000
# Compteur global journalier (toutes IP confondues) -> 503 si dépassé.
DAILY_GLOBAL_LIMIT=500

# --- Limites de taille (limits.js / server.js) ---
# Le corps JSON est plafonné à 250 ko dans server.js (express.json).
MAX_BODY_BYTES=250000
# Longueur max du texte source, en caractères (min imposé : 300).
# Abaissé à 30000 : au-delà, la génération dépasse souvent 30–40 s et risque le
# timeout (502). Un cours plus long doit être découpé. Le front prévient aussi
# l'utilisateur dès ~20000 caractères que la génération sera longue.
MAX_TEXT_LENGTH=30000

# --- Diagnostic ---
# Mettre à true pour activer des logs de diagnostic détaillés (côté serveur) :
# erreurs Gemini (statut + corps), JSON illisible, décompte et détail des rejets
# de validation. Ne jamais laisser activé en production (verbeux).
DEBUG_LLM=false
