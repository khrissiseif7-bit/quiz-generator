# Copier ce fichier en `.env` (à la racine de /server) et compléter les valeurs.
# `.env` ne doit JAMAIS être commité (voir .gitignore).

# --- Serveur ---
PORT=3000

# --- Sécurité : code d'accès ---
# Vérifié par middlewares/accessCode.js sur chaque requête /generate-quiz
# via l'en-tête X-Access-Code.
ACCESS_CODE=change-me

# --- Provider LLM ---
# Fournisseur isolé derrière une interface dans services/llm.service.js.
# Renseigner selon le provider choisi (ex: openai, anthropic, ...).
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# --- Quotas (quota.service.js) ---
# Limite de requêtes par IP sur une fenêtre glissante.
RATE_LIMIT_PER_IP=20
RATE_LIMIT_WINDOW_MS=60000
# Compteur global journalier (toutes IP confondues).
DAILY_GLOBAL_LIMIT=500

# --- Limites de taille (limits.js) ---
# Taille max du corps JSON et longueur max du texte source (en caractères).
MAX_BODY_BYTES=1000000
MAX_TEXT_LENGTH=50000
